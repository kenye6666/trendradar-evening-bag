import os
import json
import google.generativeai as genai
from openai import OpenAI

# 1. 动态模型调度
def call_llm(provider, prompt):
    if provider == "gemini":
        genai.configure(api_key=os.getenv("GEMINI_API_KEY"))
        model = genai.GenerativeModel("gemini-1.5-pro", generation_config={"response_mime_type": "application/json"})
        response = model.generate_content(prompt)
        return json.loads(response.text)
    elif provider == "openai":
        client = OpenAI(api_key=os.getenv("OPENAI_API_KEY"))
        response = client.chat.completions.create(
            model="gpt-4o",
            messages=[{"role": "user", "content": prompt}],
            response_format={"type": "json_object"}
        )
        return json.loads(response.choices[0].message.content)

# 2. 自动化合规检验流水线 (后处理)
def post_process_listing(data):
    # 严格校验 Search Terms 字节数 (UTF-8)
    st = data.get("search_terms", "")
    st_bytes = len(st.encode("utf-8"))
    
    # 字节超标自动由后端截断至合规单词边界
    if st_bytes > 249:
        words = st.split()
        trimmed_words = []
        current_bytes = 0
        for w in words:
            word_bytes = len((w + " ").encode("utf-8"))
            if current_bytes + word_bytes <= 249:
                trimmed_words.append(w)
                current_bytes += word_bytes
            else:
                break
        data["search_terms"] = " ".join(trimmed_words)
        data["st_byte_count"] = len(data["search_terms"].encode("utf-8"))
    else:
        data["st_byte_count"] = st_bytes

    return data
